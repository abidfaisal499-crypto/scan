{
  "name": "sentinelscan", "version": "0.1.0", "private": true,
  "engines": { "node": ">=22.0.0 <25" },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .", "typecheck": "tsc --noEmit",
    "format": "prettier --write .", "format:check": "prettier --check .",
    "test": "vitest run", "test:watch": "vitest",
    "db:generate": "prisma generate", "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev", "db:deploy": "prisma migrate deploy",
    "worker": "tsx workers/index.ts", "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7", "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.15", "@radix-ui/react-slot": "^1.2.3",
    "bullmq": "^5.58.5", "class-variance-authority": "^0.7.1", "clsx": "^2.1.1",
    "framer-motion": "^12.23.12", "ioredis": "^5.7.0", "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0", "next": "15.5.25", "next-auth": "^4.24.14",
    "react": "^19.1.0", "react-dom": "^19.1.0", "recharts": "^2.15.4",
    "server-only": "^0.0.1", "tailwind-merge": "^3.3.1", "tldts": "^7.0.14", "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1", "@types/node": "^22.18.0", "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9", "eslint": "^9.34.0", "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "^10.1.8", "postcss": "^8.5.6", "autoprefixer": "^10.4.21",
    "prettier": "^3.6.2", "prisma": "6.19.3", "tailwindcss": "^3.4.17", "tsx": "^4.20.5",
    "typescript": "^5.9.2", "vitest": "^3.2.4"
  }
}
