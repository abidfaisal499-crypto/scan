# Copy to .env; never commit .env. Replace every CHANGE_ME value.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://sentinel:CHANGE_ME@localhost:5432/sentinelscan?schema=public
REDIS_URL=redis://:CHANGE_ME@localhost:6379
# Compose-only credentials; must match the URLs above for local use.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sentinelscan
REDIS_PASSWORD=CHANGE_ME
# Auth is intentionally inactive until Phase 2.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
EMAIL_SERVER=
EMAIL_FROM=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_API_KEY=
# Reserved policy defaults; enforcement is a Phase 3/7 prerequisite.
SCAN_CACHE_TTL_SECONDS=3600
SCAN_TIMEOUT_MS=10000
SCAN_MAX_REDIRECTS=5
SCAN_MAX_RESPONSE_BYTES=1048576
RATE_LIMIT_ANONYMOUS_PER_HOUR=5
RATE_LIMIT_FREE_PER_DAY=50
RATE_LIMIT_PRO_PER_DAY=500
